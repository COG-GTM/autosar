                <NONQUEUED-RECEIVER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/AccDriverRequest_I/TimeGap</DATA-ELEMENT-REF>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/Constants/TimeGap_IV</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
