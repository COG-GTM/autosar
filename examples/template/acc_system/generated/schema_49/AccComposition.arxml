                  <OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/PortInterfaces/AccCalibration_I/ReadParameter</OPERATION-REF>
                  <QUEUE-LENGTH>1</QUEUE-LENGTH>
                </SERVER-COM-SPEC>
                <SERVER-COM-SPEC>
                  <OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/PortInterfaces/AccCalibration_I/WriteParameter</OPERATION-REF>
                  <QUEUE-LENGTH>1</QUEUE-LENGTH>
