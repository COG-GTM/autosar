<?xml version="1.0" encoding="utf-8"?>
<AUTOSAR xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd" xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Constants</SHORT-NAME>
      <ELEMENTS>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>TargetDistance_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/Meter</UNIT-REF>
                <UNIT-DISPLAY-NAME>m</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>250</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>RelativeSpeed_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/MeterPerSecond</UNIT-REF>
                <UNIT-DISPLAY-NAME>m/s</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>0</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>RadarTargetValid_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <SW-VALUES-PHYS>
                  <VT>RadarTargetValid_NotValid</VT>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>VehicleSpeed_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/KmPerHour</UNIT-REF>
                <UNIT-DISPLAY-NAME>km/h</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>0</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>SetSpeed_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/KmPerHour</UNIT-REF>
                <UNIT-DISPLAY-NAME>km/h</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>0</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>TimeGap_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/Second</UNIT-REF>
                <UNIT-DISPLAY-NAME>s</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>1.5</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>LongitudinalAccel_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/MeterPerSecondSquared</UNIT-REF>
                <UNIT-DISPLAY-NAME>m/s^2</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>0</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
        <CONSTANT-SPECIFICATION>
          <SHORT-NAME>TorqueRequest_IV</SHORT-NAME>
          <VALUE-SPEC>
            <APPLICATION-VALUE-SPECIFICATION>
              <CATEGORY>VALUE</CATEGORY>
              <SW-VALUE-CONT>
                <UNIT-REF DEST="UNIT">/DataTypes/Units/NewtonMeter</UNIT-REF>
                <UNIT-DISPLAY-NAME>Nm</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS>
                  <V>0</V>
                </SW-VALUES-PHYS>
              </SW-VALUE-CONT>
            </APPLICATION-VALUE-SPECIFICATION>
          </VALUE-SPEC>
        </CONSTANT-SPECIFICATION>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>