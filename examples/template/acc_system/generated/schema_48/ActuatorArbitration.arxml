<?xml version="1.0" encoding="utf-8"?>
<AUTOSAR xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd" xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ComponentTypes</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>ActuatorArbitration</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>AccelRequest</SHORT-NAME>
              <REQUIRED-COM-SPECS>
                <NONQUEUED-RECEIVER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/AccAccelRequest_I/AccelRequest</DATA-ELEMENT-REF>
                  <ALIVE-TIMEOUT>0.06</ALIVE-TIMEOUT>
                  <HANDLE-NEVER-RECEIVED>true</HANDLE-NEVER-RECEIVED>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/Constants/LongitudinalAccel_IV</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </NONQUEUED-RECEIVER-COM-SPEC>
              </REQUIRED-COM-SPECS>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/AccAccelRequest_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>VehicleSpeed</SHORT-NAME>
              <REQUIRED-COM-SPECS>
                <NONQUEUED-RECEIVER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/VehicleSpeed_I/VehicleSpeed</DATA-ELEMENT-REF>
                  <ALIVE-TIMEOUT>0</ALIVE-TIMEOUT>
                  <HANDLE-NEVER-RECEIVED>false</HANDLE-NEVER-RECEIVED>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/Constants/VehicleSpeed_IV</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </NONQUEUED-RECEIVER-COM-SPEC>
              </REQUIRED-COM-SPECS>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/VehicleSpeed_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>AccMode</SHORT-NAME>
              <REQUIRED-COM-SPECS>
                <MODE-SWITCH-RECEIVER-COM-SPEC>
                  <ENHANCED-MODE-API>false</ENHANCED-MODE-API>
                  <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/PortInterfaces/AccMode_I/accMode</MODE-GROUP-REF>
                  <SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>false</SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>
                </MODE-SWITCH-RECEIVER-COM-SPEC>
              </REQUIRED-COM-SPECS>
              <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/PortInterfaces/AccMode_I</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>EngineTorqueRequest</SHORT-NAME>
              <PROVIDED-COM-SPECS>
                <NONQUEUED-SENDER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/EngineTorqueRequest_I/TorqueRequest</DATA-ELEMENT-REF>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/Constants/TorqueRequest_IV</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </NONQUEUED-SENDER-COM-SPEC>
              </PROVIDED-COM-SPECS>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/EngineTorqueRequest_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>BrakeDecelRequest</SHORT-NAME>
              <PROVIDED-COM-SPECS>
                <NONQUEUED-SENDER-COM-SPEC>
                  <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/BrakeDecelRequest_I/DecelRequest</DATA-ELEMENT-REF>
                  <INIT-VALUE>
                    <CONSTANT-REFERENCE>
                      <CONSTANT-REF DEST="CONSTANT-SPECIFICATION">/Constants/LongitudinalAccel_IV</CONSTANT-REF>
                    </CONSTANT-REFERENCE>
                  </INIT-VALUE>
                </NONQUEUED-SENDER-COM-SPEC>
              </PROVIDED-COM-SPECS>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/BrakeDecelRequest_I</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>ActuatorArbitration_InternalBehavior</SHORT-NAME>
              <DATA-TYPE-MAPPING-REFS>
                <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/DataTypes/DataTypeMappingSets/AccTypeMappingSet</DATA-TYPE-MAPPING-REF>
              </DATA-TYPE-MAPPING-REFS>
              <EVENTS>
                <INIT-EVENT>
                  <SHORT-NAME>IT_ActuatorArbitration_Init</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/ActuatorArbitration/ActuatorArbitration_InternalBehavior/ActuatorArbitration_Init</START-ON-EVENT-REF>
                </INIT-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>TMT_ActuatorArbitration_Run</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/ActuatorArbitration/ActuatorArbitration_InternalBehavior/ActuatorArbitration_Run</START-ON-EVENT-REF>
                  <PERIOD>0.01</PERIOD>
                </TIMING-EVENT>
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>DRT_ActuatorArbitration_OnAccelRequest_AccelRequest_AccelRequest</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/ActuatorArbitration/ActuatorArbitration_InternalBehavior/ActuatorArbitration_OnAccelRequest</START-ON-EVENT-REF>
                  <DATA-IREF>
                    <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccelRequest</CONTEXT-R-PORT-REF>
                    <TARGET-DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/AccAccelRequest_I/AccelRequest</TARGET-DATA-ELEMENT-REF>
                  </DATA-IREF>
                </DATA-RECEIVED-EVENT>
                <SWC-MODE-SWITCH-EVENT>
                  <SHORT-NAME>MST_ActuatorArbitration_OnAccActivated</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/ComponentTypes/ActuatorArbitration/ActuatorArbitration_InternalBehavior/ActuatorArbitration_OnAccActivated</START-ON-EVENT-REF>
                  <ACTIVATION>ON-ENTRY</ACTIVATION>
                  <MODE-IREFS>
                    <MODE-IREF>
                      <CONTEXT-PORT-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccMode</CONTEXT-PORT-REF>
                      <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/PortInterfaces/AccMode_I/accMode</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                      <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/ModeDclrGroups/AccMode/ACTIVE</TARGET-MODE-DECLARATION-REF>
                    </MODE-IREF>
                  </MODE-IREFS>
                </SWC-MODE-SWITCH-EVENT>
              </EVENTS>
              <PORT-API-OPTIONS>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>false</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccelRequest</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>false</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccMode</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>false</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/BrakeDecelRequest</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>false</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/EngineTorqueRequest</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>false</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/VehicleSpeed</PORT-REF>
                </PORT-API-OPTION>
              </PORT-API-OPTIONS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ActuatorArbitration_Init</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <SYMBOL>ActuatorArbitration_Init</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ActuatorArbitration_Run</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>REC_AccelRequest_AccelRequest</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccelRequest</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/AccAccelRequest_I/AccelRequest</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>REC_VehicleSpeed_VehicleSpeed</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/VehicleSpeed</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/VehicleSpeed_I/VehicleSpeed</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>SEND_EngineTorqueRequest_TorqueRequest</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/EngineTorqueRequest</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/EngineTorqueRequest_I/TorqueRequest</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>SEND_BrakeDecelRequest_DecelRequest</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/BrakeDecelRequest</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/BrakeDecelRequest_I/DecelRequest</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <SYMBOL>ActuatorArbitration_Run</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ActuatorArbitration_OnAccelRequest</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>REC_AccelRequest_AccelRequest</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/ComponentTypes/ActuatorArbitration/AccelRequest</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/PortInterfaces/AccAccelRequest_I/AccelRequest</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <SYMBOL>ActuatorArbitration_OnAccelRequest</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>ActuatorArbitration_OnAccActivated</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <SYMBOL>ActuatorArbitration_OnAccActivated</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <SWC-IMPLEMENTATION>
          <SHORT-NAME>ActuatorArbitration_Implementation</SHORT-NAME>
          <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/ComponentTypes/ActuatorArbitration/ActuatorArbitration_InternalBehavior</BEHAVIOR-REF>
        </SWC-IMPLEMENTATION>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
